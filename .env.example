# Copy to .env and fill in. Never commit .env.
# All free, no credit card. Stiti runs NO local LLM, so at least one key is needed for thinking.
GROQ_API_KEY=          # https://console.groq.com/keys      (primary, fastest)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai          (secondary + night jobs)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys         (backup, 50 req/day free)
MISTRAL_API_KEY=       # optional; opt out of training in console first
GEMINI_API_KEY=        # optional; only ever used for P0 (non-personal) turns

STITI_DB=postgresql:///stiti
STITI_HOME=~/.stiti
STITI_TZ=Asia/Kolkata
