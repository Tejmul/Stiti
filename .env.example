# Copy to .env and fill in. Never commit .env.
# All free, no credit card. Stiti runs NO local LLM, so at least one key is needed for thinking.
GROQ_API_KEY=          # https://console.groq.com/keys      (primary, fastest)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai  (now asks for a card since 2026-07 — skip unless you have one)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys         (backup, 50 req/day free)
MISTRAL_API_KEY=       # optional; opt out of training in console first
GEMINI_API_KEY=        # optional; only ever used for P0 (non-personal) turns

# --- extra free LLM providers (added 2026-11-10; all free, no card) ---
ZAI_API_KEY=           # https://z.ai/manage-apikey/apikey-list  (GLM-4.7-Flash, free, Chinese model, no training on API data)
CLOUDFLARE_API_KEY=    # dash.cloudflare.com → My Profile → API Tokens → "Workers AI" template
CLOUDFLARE_ACCOUNT_ID= # dash.cloudflare.com → right sidebar "Account ID" (10k free neurons/day)
NVIDIA_API_KEY=        # https://build.nvidia.com → any model → "Get API Key" (DeepSeek/Kimi/Qwen; public questions only)

STITI_DB=postgresql:///stiti
STITI_HOME=~/.stiti
STITI_TZ=Asia/Kolkata

# --- connectors (optional) ---
MAIL_ADDRESS=          # Gmail address (read-only IMAP)
MAIL_APP_PASSWORD=     # myaccount.google.com → Security → 2-Step Verification → App passwords
TELEGRAM_BOT_TOKEN=    # @BotFather → /newbot; then send "/pair <code>" (code printed in ~/.stiti/logs/app.log)
# STITI_VOICE_EMOTION=emotion2vec   # deep voice emotion (+1.5 GB RAM; off by default on 8 GB)
# STITI_AEC=off             # disable echo cancellation (half-duplex)
